{% extends "layouts/main.njk" %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitle %}
  What is your National Insurance number? – Apply for a permit – GOV.UK
{% endblock %}

{% block beforeContent %}
  {{ govukBackLink({ text: "Back", href: "/start" }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" action="/confirmation" novalidate>
        {{ govukInput({
          label: {
            text: "What is your National Insurance number?",
            classes: "govuk-label--l",
            isPageHeading: true
          },
          hint: {
            text: "For example, QQ 12 34 56 C. It is on your National Insurance card, benefit letter, payslip or P60."
          },
          id: "nino",
          name: "nino",
          classes: "govuk-input--width-10",
          spellcheck: false
        }) }}
        {{ govukButton({ text: "Submit application" }) }}
      </form>
    </div>
  </div>
{% endblock %}
